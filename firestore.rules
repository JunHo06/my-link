rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ----------------------------------------------------
    // 공통 헬퍼 함수
    // ----------------------------------------------------
    
    // 사용자가 로그인되어 있는지 확인
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // 요청한 사용자가 리소스의 소유자(userId)인지 확인
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ----------------------------------------------------
    // 보안 규칙 설정
    // ----------------------------------------------------

    match /users/{userId}/links/{linkId} {
      allow read: if true;
      allow create, delete: if isOwner(userId);
      allow update: if isOwner(userId) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']) &&
        request.resource.data.clicks == resource.data.get('clicks', 0) + 1
      );
    }
    
    // 2. 유저 프로필 정보 (users/{userId}/profile/{documentId})
    // - 읽기: 비로그인 사용자를 포함한 누구나 가능 (공개 프로필 홈 노출용)
    // - 쓰기: 로그인한 본인의 데이터 영역만 가능 (생성, 수정, 삭제)
    match /users/{userId}/profile/{documentId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
    
    // 3. 고유 닉네임/주소 중복 방지 매핑 테이블 (usernames/{username})
    // - 읽기: 누구나 가능 (닉네임 중복 체크 및 displayName 기반 UID 검색 목적)
    // - 쓰기 (생성): 로그인 상태여야 하며, 등록하려는 데이터의 uid가 본인의 UID와 동일해야 함
    // - 쓰기 (수정): 본인의 매핑 데이터이며, 수정하려는 타겟 UID 역시 본인의 UID여야 함
    // - 쓰기 (삭제): 본인이 등록한 매핑 정보만 삭제 가능
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
  }
}
